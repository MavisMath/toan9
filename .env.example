# Sao chép file này thành .env, sau đó điền API key Gemini của bạn.
# Không chia sẻ hoặc đưa file .env lên Git.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# SQL Server (Windows Authentication, chạy local)
SQL_SERVER=localhost\MSSQLSERVER01
SQL_DATABASE=Toan9_DB
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
